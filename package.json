{
  "name": "pr-size-risk-labeler",
  "version": "1.0.0",
  "description": "GitHub Action: auto-label PR size and risk",
  "main": "action-dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc && ncc build dist/main.js -o action-dist --license licenses.txt",
    "test": "jest --verbose",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^10.3.0",
    "eslint-plugin-jest": "^29.15.2",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "author": "tuty",
  "license": "UNLICENSED"
}
